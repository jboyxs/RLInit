<mujoco model="door lock fixture">
  <!-- Adapted from door_lock.xml (robosuite / mj_envs).
       Keep the original panel and handle mass/dynamics; use solid materials
       so this scene does not require the separately distributed textures.
       All names are prefixed to avoid collisions with robot assets.
       This is a small laboratory door, mounted on floor-supported posts.
       Dimensions are meters; the including scene must use radians. -->
  <asset>
    <material name="door_wood" rgba="0.45 0.25 0.12 1"/>
    <material name="door_metal" rgba="0.65 0.55 0.35 1" specular="0.5" shininess="0.3"/>
    <material name="door_frame_material" rgba="0.75 0.78 0.8 1"/>
  </asset>
  <worldbody>
    <!-- Handle site at approximately (0.720, 0.000, 0.775) in world coordinates.
         Jointless fixture/frame bodies are fixed; only door and handle move. -->
    <body name="door_fixture" pos="0.82 0.03 0.8">
      <body name="door_frame" pos="0 0.22 0" quat="0.707388 0 0 -0.706825">
        <inertial pos="0.3 0 0" quat="0.5 0.5 0.5 0.5" mass="7.85398" diaginertia="0.923301 0.764585 0.168533"/>
        <geom name="door_right_frame" type="cylinder" size="0.03 0.3" pos="0.555 0 0" material="door_frame_material"/>
        <geom name="door_left_frame" type="cylinder" size="0.03 0.3" pos="0.045 0 0" material="door_frame_material"/>
        <!-- Extend the original frame posts down from z=0.5 to the floor. -->
        <geom name="door_right_support" type="cylinder" size="0.03 0.25" pos="0.555 0 -0.55" material="door_frame_material"/>
        <geom name="door_left_support" type="cylinder" size="0.03 0.25" pos="0.045 0 -0.55" material="door_frame_material"/>
        <body name="door_panel_body" pos="0.3 0 0">
          <inertial pos="0.0296816 -0.00152345 0" quat="0.701072 0 0 0.713091" mass="2.43455" diaginertia="0.0913751 0.0521615 0.043714"/>
          <joint name="door_hinge" type="hinge" pos="0.255 0 0" axis="0 0 1" range="0 0.4" damping="1" frictionloss="1" limited="true"/>
          <geom name="door_panel" type="box" size="0.22 0.02 0.29" friction="1 1 1" material="door_wood"/>
          <body name="door_handle_body" pos="-0.175 0 -0.025">
            <inertial pos="-0.017762 0.0138544 0" quat="0.365653 0.605347 -0.36522 0.605365" mass="0.1" diaginertia="0.0483771 0.0410001 0.0111013"/>
            <!-- Positive rotation depresses the handle; the zero lower stop
                 blocks lifting it above horizontal. The upper travel remains
                 90 degrees; 45 degrees below is the latch-release target. -->
            <joint name="door_latch_joint" type="hinge" pos="0 0 0" axis="0 1 0" range="0 1.57" frictionloss="0.1" damping="0" limited="true" springref="0" stiffness="1" solreflimit="0.004 1" solimplimit="0.99 0.999 0.0001"/>
            <geom name="door_handle_base" type="cylinder" fromto="0 0.0625 0 0 -0.125 0" size="0.025" material="door_metal"/>
            <geom name="door_handle" type="box" size="0.075 0.015 0.02" pos="0.075 -0.10 0" material="door_metal"/>
            <!-- A 54 mm tongue with a 6 mm rounded tip still blocks the closed
                 door at zero angle. Sweeping the door through 0..0.4 rad gives
                 first geometric clearance near 42.35 degrees, with about
                 1.7 mm clearance at a 45-degree handle depression. -->
            <geom name="door_latch" type="box" size="0.006 0.0125 0.027" pos="-0.027 0.05 0" quat="0.707388 0 0.706825 0" material="door_metal"/>
            <geom name="door_latch_tip" type="cylinder" size="0.006 0.0125" pos="-0.054 0.05 0" quat="0.707388 0.706825 0 0" material="door_metal"/>
            <site name="door_handle_site" pos="0.125 -0.10 0" size="0.01" rgba="0 0 1 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
